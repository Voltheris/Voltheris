# Required for the contact form (app/api/contact/route.ts) to actually
# send email. Sign up at https://resend.com, verify a sending domain
# (getvoltheris.com or a subdomain of it), then generate an API key.
#
# Add this as an Environment Variable in Vercel (Project → Settings →
# Environment Variables) for Production/Preview — do NOT commit a real
# key to this file or anywhere in the repo.
RESEND_API_KEY=

# Required for the /admin dashboard: contact-form submission storage,
# page-view counts, and CTA click counts. Create a free database at
# https://console.upstash.com, then copy these two values from its
# REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required to log into /admin. Set these in Vercel, not here — do NOT
# commit real values. Whatever you set these to is your login; there
# is no separate "default" password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
